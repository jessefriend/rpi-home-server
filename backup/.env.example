# Copy to backup/.env and edit.

# Restic repository on the mounted external drive.
RESTIC_REPO=/mnt/backup/restic

# Use a strong password and store it safely.
RESTIC_PASSWORD=change-me

# Optional custom mount point for your drive.
BACKUP_MOUNT=/mnt/backup

# Optional retention settings.
KEEP_LAST=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
