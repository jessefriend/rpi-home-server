# DO NOT COMMIT .env
# Contains secrets.

TZ=Europe/Berlin

# Domain / TLS
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Optional DNS-01 support for private or Tailscale-only domains.
# Example plugin: github.com/caddy-dns/<provider>
# Example issuer config: acme_dns <provider> CHANGE_ME
CADDY_DNS_PLUGIN=
CADDY_TLS_ISSUER_CONFIG=

# Immich
IMMICH_VERSION=release
IMMICH_UPLOAD_LOCATION=/srv/nas/photos/immich-library
IMMICH_DB_DATA_LOCATION=/srv/appdata/immich/postgres
IMMICH_DB_USERNAME=immich
IMMICH_DB_PASSWORD=CHANGE_ME_IMMICH_DB_PASSWORD
IMMICH_DB_NAME=immich
IMMICH_MACHINE_LEARNING_WORKERS=1
IMMICH_WORKERS=1

# OpenCloud
OPENCLOUD_CONFIG_LOCATION=/srv/appdata/opencloud/config
OPENCLOUD_DATA_LOCATION=/srv/nas/files/opencloud-data
OPENCLOUD_ADMIN_PASSWORD=CHANGE_ME_OPENCLOUD_ADMIN_PASSWORD
OPENCLOUD_URL=https://cloud.example.com
